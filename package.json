{
  "name": "galactic-receipt-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "build": "node scripts/assets.mjs && node scripts/build.mjs",
    "dev": "node scripts/test-server.mjs",
    "db:generate": "drizzle-kit generate",
    "site:sync-source": "node scripts/site_source_sync.mjs",
    "check": "npm run typecheck && npm run format:check && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "test:e2e": "playwright test",
    "test:site-source-sync": "node --test scripts/site_source_sync.test.mjs",
    "format:check": "prettier --check web worker db scripts/*.mjs *.ts *.json *.md"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "html2canvas": "1.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.2",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "miniflare": {
      "sharp": "^0.35.4",
      "undici": "^7.29.0"
    }
  }
}
